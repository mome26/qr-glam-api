<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>{{eventName}} - Kỷ Niệm</title>
    <style>
        :root {
            --midnight: #0f172a;
            --gold: #c5a059;
            --dark-gold: #8e6d2f;
            --glass: rgba(15, 23, 42, 0.85);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body, html {
            height: 100%;
            width: 100%;
            overflow: hidden;
            background-color: #000;
            font-family: 'Segoe UI', serif;
        }

        .shorts-container {
            position: relative;
            height: 100%;
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        /* MEDIA LAYER: NO ZOOM, HD NATIVE */
        .media-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
        }

        .media-layer iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* ART DECO DECORATIONS */
        .deco-corner {
            position: absolute;
            width: 50px;
            height: 50px;
            border: 2px solid var(--gold);
            z-index: 10;
            pointer-events: none;
        }
        .top-left { top: 20px; left: 20px; border-right: 0; border-bottom: 0; }
        .top-right { top: 20px; right: 20px; border-left: 0; border-bottom: 0; }
        .bottom-left { bottom: 20px; left: 20px; border-right: 0; border-top: 0; }
        .bottom-right { bottom: 20px; right: 20px; border-left: 0; border-top: 0; }

        /* CONTENT OVERLAY */
        .content-overlay {
            position: relative;
            z-index: 15;
            padding: 40px 30px;
            padding-bottom: calc(40px + env(safe-area-inset-bottom));
            background: linear-gradient(transparent, var(--glass) 30%, var(--midnight) 90%);
            text-align: center;
        }

        .header h1 {
            font-size: 16px;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 5px;
            margin-bottom: 5px;
        }

        .deco-line {
            height: 1px;
            background: var(--gold);
            width: 60px;
            margin: 10px auto 20px auto;
        }

        .guest-info h2 {
            font-size: 24px;
            color: var(--gold);
            font-weight: 300;
            margin-bottom: 25px;
            font-family: 'Times New Roman', serif;
        }

        /* BUTTONS */
        .btn-stack {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            padding: 16px;
            text-align: center;
            text-decoration: none;
            font-weight: bold;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: 0.3s;
            clip-path: polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%);
            cursor: pointer;
            display: block;
        }

        .btn-gold { background: var(--gold); color: var(--midnight); }
        .btn-outline { background: transparent; color: var(--gold); border: 1px solid var(--gold); }

        .loader {
            position: absolute;
            top: 45%; left: 50%;
            transform: translate(-50%, -50%);
            width: 40px; height: 40px;
            border: 2px solid rgba(197, 160, 89, 0.1);
            border-top: 2px solid var(--gold);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            z-index: 5;
        }
        @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
    </style>
</head>

<body>

    <div class="shorts-container">
        <div class="deco-corner top-left"></div>
        <div class="deco-corner top-right"></div>
        <div class="deco-corner bottom-left"></div>
        <div class="deco-corner bottom-right"></div>
        
        <div class="loader" id="mainLoader"></div>

        <div class="media-layer">
            {{#if embedUrl}}
                <iframe 
                    id="videoFrame" 
                    src="{{embedUrl}}" 
                    allow="autoplay; encrypted-media" 
                    onload="document.getElementById('mainLoader').style.display='none';">
                </iframe>
            {{/if}}
        </div>

        <div class="content-overlay">
            <div class="header">
                <h1>{{eventName}}</h1>
                <div class="deco-line"></div>
            </div>

            <div class="guest-info">
                <h2>{{guestName}}</h2>
            </div>

            <div class="btn-stack">
                <a id="downloadBtn" href="#" target="_blank" class="btn btn-gold">Tải xuống</a>
                <div onclick="handleShare()" class="btn btn-outline">Chia sẻ khoảnh khắc</div>
            </div>

            <div class="footer" style="margin-top:20px; color:var(--gold); font-size:9px; opacity:0.5; letter-spacing:2px; text-align:center;">
                &copy; {{year}} | QUÝ TỘC
            </div>
        </div>
    </div>

    <script>
        (function() {
            const frame = document.getElementById('videoFrame');
            const downloadBtn = document.getElementById('downloadBtn');
            const originalUrl = "{{embedUrl}}";

            if (originalUrl.includes('drive.google.com')) {
                // 1. Extract File ID
                const fileId = originalUrl.match(/\/d\/([^\/]+)/)?.[1];
                
                if (fileId) {
                    // 2. Set Video Frame to Preview with 1080p flag
                    frame.src = `https://drive.google.com/file/d/${fileId}/preview?vq=hd1080`;
                    
                    // 3. Set Download Button to Direct Download endpoint
                    downloadBtn.href = `https://drive.google.com/uc?export=download&id=${fileId}`;
                }
            } else {
                // Fallback if not a Drive link
                downloadBtn.href = originalUrl;
            }
        })();

        function handleShare() {
            if (navigator.share) {
                navigator.share({
                    title: '{{eventName}}',
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert("Đã sao chép liên kết!");
            }
        }
    </script>
</body>

</html>