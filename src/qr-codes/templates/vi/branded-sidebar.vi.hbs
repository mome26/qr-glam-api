<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{eventName}} - Media</title>
    <style>
        :root {
            --navy: #0f172a;
            --gold: #c5a059;
            --white: #ffffff;
            --bg: #f1f5f9;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg);
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .split-card {
            background: var(--white);
            width: 100%;
            max-width: 900px;
            display: flex;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        /* Fixed Sidebar */
        .sidebar {
            background: var(--navy);
            width: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-right: 4px solid var(--gold);
        }

        .vertical-text {
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 5px;
            font-weight: 800;
            font-size: 14px;
            white-space: nowrap;
        }

        /* Main Content */
        .main-pane {
            flex: 1;
            padding: 50px;
        }

        .welcome-header { margin-bottom: 30px; }
        .welcome-header h1 { font-size: 28px; color: var(--navy); margin-bottom: 5px; }
        .welcome-header p { color: #64748b; font-size: 16px; }

        .media-display {
            background: #000;
            border-radius: 8px;
            overflow: hidden;
            line-height: 0;
            margin-bottom: 35px;
            box-shadow: 0 10px 15px rgba(0,0,0,0.05);
        }

        .media-display video, .media-display img {
            width: 100%;
            max-height: 450px;
            object-fit: contain;
        }

        .action-row {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: 0.2s;
        }

        .btn-gold {
            background: var(--gold);
            color: var(--navy);
        }

        .btn-gold:hover { background: #d4af37; }

        .btn-link {
            color: var(--navy);
            border: 1px solid #cbd5e1;
        }

        .btn-link:hover { background: #f8fafc; }

        @media (max-width: 768px) {
            .split-card { flex-direction: column; }
            .sidebar { width: 100%; height: 50px; border-right: 0; border-bottom: 4px solid var(--gold); }
            .vertical-text { writing-mode: horizontal-tb; transform: rotate(0); letter-spacing: 2px; }
            .main-pane { padding: 30px 20px; }
        }
    </style>
</head>
<body>

    <div class="split-card">
        <aside class="sidebar">
            <div class="vertical-text">{{eventName}}</div>
        </aside>

        <main class="main-pane">
            <div class="welcome-header">
                <h1>Chào buổi tối, {{guestName}}</h1>
                <p>Cảm ơn bạn đã tham dự sự kiện của chúng tôi.</p>
            </div>

            <div class="media-display">
                {{#if isVideo}}
                    <video controls preload="auto" poster="{{thumbnailUrl}}">
                        <source src="{{mediaUrl}}" type="video/mp4">
                    </video>
                {{else}}
                    <img src="{{mediaUrl}}" alt="Media for {{guestName}}">
                {{/if}}
            </div>

            <div class="action-row">
                <a href="{{mediaUrl}}" download class="btn btn-gold">TẢI VỀ TỆP GỐC</a>
                {{#if driveViewUrl}}
                <a href="{{driveViewUrl}}" target="_blank" class="btn btn-link">XEM THƯ VIỆN CHUNG</a>
                {{/if}}
            </div>
        </main>
    </div>

</body>
</html>
