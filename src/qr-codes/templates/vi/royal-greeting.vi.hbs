<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{eventName}} - Kỷ Niệm Quý Khách</title>
    <style>
        :root {
            --navy-deep: #0a0e1a;
            --gold-matte: #b38e44;
            --gold-bright: #d4af37;
            --cream: #fcfaf7;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: #f0f2f5;
            font-family: 'Playfair Display', serif; /* Pair this with a standard serif in production if needed */
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            background: white;
            width: 100%;
            max-width: 800px;
            border-radius: 4px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.2);
            overflow: hidden;
        }

        /* Split Header Design */
        .header-split {
            display: flex;
            flex-wrap: wrap;
            border-bottom: 4px solid var(--gold-matte);
        }

        .header-left {
            flex: 1;
            background: var(--navy-deep);
            color: white;
            padding: 40px;
            min-width: 300px;
        }

        .header-right {
            flex: 1;
            background: var(--gold-matte);
            color: var(--navy-deep);
            padding: 40px;
            min-width: 300px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .header-left h1 {
            font-size: 24px;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .header-left p {
            font-size: 12px;
            letter-spacing: 5px;
            opacity: 0.7;
        }

        .header-right h2 {
            font-size: 20px;
            font-weight: 400;
            margin-bottom: 5px;
        }

        .header-right .guest-name {
            font-size: 28px;
            font-weight: 700;
            text-transform: capitalize;
        }

        .media-section {
            padding: 50px 40px;
            background: var(--cream);
            text-align: center;
        }

        .media-wrapper {
            background: #000;
            padding: 10px;
            border: 1px solid #e0d5c1;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            position: relative;
        }

        /* Subtle Corner Accents */
        .media-wrapper::before, .media-wrapper::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid var(--gold-matte);
        }
        .media-wrapper::before { top: -5px; left: -5px; border-right: 0; border-bottom: 0; }
        .media-wrapper::after { bottom: -5px; right: -5px; border-left: 0; border-top: 0; }

        .media-wrapper img, .media-wrapper video {
            width: 100%;
            display: block;
            height: auto;
            max-height: 500px;
        }

        .actions-section {
            padding: 0 40px 50px;
            background: var(--cream);
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .btn {
            padding: 15px 30px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            border: 1px solid var(--navy-deep);
        }

        .btn-gold {
            background: var(--navy-deep);
            color: white;
        }

        .btn-gold:hover {
            background: transparent;
            color: var(--navy-deep);
        }

        .btn-outline {
            background: transparent;
            color: var(--navy-deep);
        }

        .btn-outline:hover {
            background: var(--navy-deep);
            color: white;
        }

        .footer {
            padding: 20px;
            text-align: center;
            font-size: 11px;
            background: white;
            color: #999;
            letter-spacing: 1px;
        }

        @media (max-width: 600px) {
            .header-left, .header-right { padding: 30px 20px; text-align: center; }
            .actions-section { flex-direction: column; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-split">
            <div class="header-left">
                <h1>{{eventName}}</h1>
                <p>THƯ VIỆN ĐIỆN TỬ</p>
            </div>
            <div class="header-right">
                <h2>Kính chào Quý khách,</h2>
                <div class="guest-name">{{guestName}}</div>
            </div>
        </div>

        <div class="media-section">
            <div class="media-wrapper">
                {{#if embedUrl}}
                    <iframe src="{{embedUrl}}" allow="autoplay" allowfullscreen style="width:100%; height:400px; border:none;"></iframe>
                {{else if isVideo}}
                    <video controls preload="auto" poster="{{thumbnailUrl}}">
                        <source src="{{mediaUrl}}" type="video/mp4">
                        Trình duyệt không hỗ trợ.
                    </video>
                {{else}}
                    <img src="{{mediaUrl}}" alt="{{guestName}}" loading="lazy">
                {{/if}}
            </div>
        </div>

        <div class="actions-section">
            <a href="{{#if downloadUrl}}{{downloadUrl}}{{else}}{{mediaUrl}}{{/if}}" download class="btn btn-gold">Tải ảnh về</a>
            {{#if driveViewUrl}}
            <a href="{{driveViewUrl}}" target="_blank" class="btn btn-outline">Xem bộ sưu tập</a>
            {{/if}}
        </div>

        <footer class="footer">
            TRÂN TRỌNG CẢM ƠN QUÝ KHÁCH ĐÃ THAM GIA | &copy; {{year}}
        </footer>
    </div>

</body>
</html>
