<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{eventName}} - {{guestName}}</title>
    <style>
        :root {
            --navy: #0f172a;
            --gold: #c5a059;
            --white: #ffffff;
            --slate: #f1f5f9;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--slate);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background: var(--white);
            width: 100%;
            max-width: 700px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            position: relative;
            overflow: hidden;
        }

        /* Diagonal Header Accent */
        .header {
            background: var(--navy);
            color: var(--white);
            padding: 60px 40px;
            clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
            text-align: left;
        }

        .header h1 {
            font-size: 28px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            margin-bottom: 5px;
        }

        .header p {
            color: var(--gold);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .main-content {
            padding: 40px;
            margin-top: -20px;
        }

        .guest-greeting {
            margin-bottom: 30px;
        }

        .guest-greeting h2 {
            font-size: 22px;
            color: var(--navy);
        }

        .guest-greeting p {
            color: #64748b;
            font-size: 15px;
        }

        .media-box {
            background: #000;
            border-left: 5px solid var(--gold);
            box-shadow: 10px 10px 0px var(--slate);
            margin-bottom: 40px;
            line-height: 0;
        }

        .media-box img, .media-box video {
            width: 100%;
            height: auto;
            max-height: 500px;
            display: block;
        }

        .media-box iframe {
            width: 100%;
            height: 400px;
            border: none;
        }

        .actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            text-align: center;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .btn-download {
            background: var(--navy);
            color: var(--white);
        }

        .btn-download:hover {
            background: var(--gold);
            color: var(--navy);
        }

        .btn-drive {
            border: 2px solid var(--navy);
            color: var(--navy);
        }

        .btn-drive:hover {
            background: var(--slate);
        }

        .footer {
            padding: 30px 40px;
            background: var(--white);
            border-top: 1px solid var(--slate);
            font-size: 12px;
            color: #94a3b8;
            text-align: center;
        }

        @media (max-width: 480px) {
            .header { padding: 40px 20px; }
            .main-content { padding: 25px; }
            .actions { flex-direction: column; }
        }
    </style>
</head>
<body>

    <div class="container">
        <header class="header">
            <h1>{{eventName}}</h1>
            <p>Hồ sơ lưu trữ sự kiện</p>
        </header>

        <div class="main-content">
            <div class="guest-greeting">
                <h2>Kính chào, {{guestName}}</h2>
                <p>Mời bạn xem và tải xuống các phương tiện truyền thông của mình.</p>
            </div>

            <div class="media-box">
                {{#if embedUrl}}
                    <iframe src="{{embedUrl}}" allowfullscreen></iframe>
                {{else if isVideo}}
                    <video controls preload="auto" poster="{{thumbnailUrl}}">
                        <source src="{{mediaUrl}}" type="video/mp4">
                        Trình duyệt không hỗ trợ xem video.
                    </video>
                {{else if mediaUrl}}
                    <img src="{{mediaUrl}}" alt="Kỷ niệm của {{guestName}}" loading="lazy">
                {{else}}
                    <div style="padding: 60px; color: #fff; text-align: center;">📸 Hình ảnh đang được cập nhật...</div>
                {{/if}}
            </div>

            <div class="actions">
                <a href="{{#if downloadUrl}}{{downloadUrl}}{{else}}{{mediaUrl}}{{/if}}" download class="btn btn-download">Tải xuống tệp</a>
                {{#if driveViewUrl}}
                <a href="{{driveViewUrl}}" target="_blank" class="btn btn-drive">Xem trên Drive</a>
                {{/if}}
            </div>
        </div>

        <footer class="footer">
            <p>© {{year}} {{eventName}} | Hệ thống Media chuyên nghiệp</p>
        </footer>
    </div>

</body>
</html>
