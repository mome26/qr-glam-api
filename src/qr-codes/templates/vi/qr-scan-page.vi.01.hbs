<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{eventName}} - Kỷ Niệm Từ Sự Kiện</title>
    <style>
        :root {
            --midnight-navy: #0a1128;
            --premium-gold: #c5a059;
            --gold-gradient: linear-gradient(135deg, #c5a059 0%, #8e6d2f 100%);
            --soft-white: #f8fafc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Times New Roman', serif; /* Classic professional feel */
            background-color: #050a18;
            background-image: radial-gradient(circle at top right, #101d42, #050a18);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #333;
        }
        
        .container {
            background: white;
            border-radius: 8px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            max-width: 650px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(197, 160, 89, 0.3);
        }
        
        .header {
            background: var(--midnight-navy);
            color: white;
            padding: 50px 20px;
            text-align: center;
            border-bottom: 3px solid var(--premium-gold);
        }
        
        .header h1 {
            font-size: 32px;
            margin-bottom: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-family: 'Georgia', serif;
            color: var(--premium-gold);
        }
        
        .header p {
            font-size: 14px;
            letter-spacing: 3px;
            text-transform: uppercase;
            opacity: 0.8;
        }
        
        .guest-info {
            padding: 30px 20px 0;
            text-align: center;
        }
        
        .guest-info h2 {
            color: var(--midnight-navy);
            font-size: 24px;
            margin-bottom: 6px;
        }
        
        .guest-info p {
            color: #666;
            font-size: 15px;
            font-style: italic;
        }
        
        .media-container {
            padding: 30px 25px;
            text-align: center;
        }
        
        .media-display {
            margin-bottom: 25px;
            background: #000;
            border-radius: 4px;
            line-height: 0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border: 1px solid #eee;
        }
        
        .media-display img, .media-display video {
            max-width: 100%;
            height: auto;
            max-height: 500px;
            object-fit: contain;
        }
        
        .media-display iframe {
            max-width: 100%;
            width: 100%;
            height: 400px;
            border: none;
        }
        
        .placeholder {
            background: #fdfdfd;
            border: 1px solid #ddd;
            padding: 80px 20px;
            color: #999;
        }
        
        .actions {
            padding: 0 25px 40px;
            display: flex;
            gap: 15px;
            justify-content: center;
        }
        
        .btn {
            padding: 12px 25px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .btn-primary {
            background: var(--gold-gradient);
            color: white;
            border: none;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(142, 109, 47, 0.4);
        }
        
        .btn-secondary {
            background: transparent;
            color: var(--midnight-navy);
            border: 1px solid var(--midnight-navy);
        }
        
        .btn-secondary:hover {
            background: #f0f0f0;
        }
        
        .footer {
            padding: 25px;
            background: var(--soft-white);
            text-align: center;
            font-size: 12px;
            color: #888;
            border-top: 1px solid #eee;
        }
        
        @media (max-width: 480px) {
            .header h1 { font-size: 24px; }
            .actions { flex-direction: column; }
            .btn { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{eventName}}</h1>
            <p>Thư Viện Ảnh Kỷ Niệm</p>
        </div>
        
        {{#if guestName}}
        <div class="guest-info">
            <h2>Kính chào, {{guestName}}!</h2>
            <p>Trân trọng gửi đến quý khách những khoảnh khắc đáng nhớ</p>
        </div>
        {{/if}}
        
        <div class="media-container">
            <div class="media-display">
                {{#if embedUrl}}
                    <iframe src="{{embedUrl}}" allow="autoplay" allowfullscreen></iframe>
                {{else if isVideo}}
                    <video controls preload="auto"{{#if thumbnailUrl}} poster="{{thumbnailUrl}}"{{/if}}>
                        <source src="{{mediaUrl}}" type="video/mp4">
                        Trình duyệt của quý khách không hỗ trợ xem video trực tiếp.
                    </video>
                {{else if mediaUrl}}
                    <img src="{{mediaUrl}}" alt="Kỷ niệm của {{guestName}}" loading="lazy">
                {{else}}
                <div class="placeholder">
                    <div style="font-size: 40px; margin-bottom: 10px;">📸</div>
                    <div class="placeholder-text">Hình ảnh hiện chưa sẵn sàng</div>
                </div>
                {{/if}}
            </div>
        </div>
        
        <div class="actions">
            {{#if downloadUrl}}
            <a href="{{downloadUrl}}" download class="btn btn-primary">Tải Xuống</a>
            {{else if mediaUrl}}
            <a href="{{mediaUrl}}" download class="btn btn-primary">Tải Xuống</a>
            {{/if}}
            
            {{#if driveViewUrl}}
            <a href="{{driveViewUrl}}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Xem Trên Drive</a>
            {{/if}}
        </div>
        
        <div class="footer">
            <p>&copy; {{year}} {{eventName}}. Trân trọng cảm ơn quý khách.</p>
        </div>
    </div>
</body>
</html>
