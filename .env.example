# Database
DATABASE_PATH=./data/qr-glam.db
DATABASE_LOGGING=false

# API
# HOST: Network interface to bind to
# - 0.0.0.0 = all interfaces (accessible from network)
# - 127.0.0.1 or localhost = local only
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Runtime Configuration
# BASE_URL: Public URL where the API is accessible
# - Development: http://localhost:3000
# - Production: https://your-domain.com
# - QR codes will use this URL for redirect links
# In development, defaults to http://localhost:3000 if not set
BASE_URL=http://localhost:3000

# Google Drive Provider (API Key Auth)
GOOGLE_API_KEY=your_google_api_key_here

MAX_EVENT_ACTIVITIES=200
