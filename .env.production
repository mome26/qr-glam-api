# Database
DATABASE_PATH=./data/qr-glam.db
DATABASE_LOGGING=false

# API
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Runtime Configuration
BASE_URL=https://api.glambot.vn
FRONTEND_URL=https://mediadelivery.glambot.vn

# Google Drive Provider (API Key Auth)
GOOGLE_API_KEY=your_google_api_key_here

# JWT
JWT_SECRET=your_jwt_secret_here

MAX_EVENT_ACTIVITIES=200
